# Values may be quoted: ONE pair of matching surrounding quotes is stripped
# ("20" and '20' both mean 20). Prefer unquoted values. A missing or malformed
# setting does not crash-loop the unit: the worker logs
# "[LEASE-ALERT] CONFIG_ERROR key=<KEY> err=..." every 10 minutes and stays
# idle (no ticks, no quotes, no heartbeat) until the .env is fixed and the unit
# is restarted.
YOMINET_RPC="https://rpc.example"
WORLD_ADDR="0x0000000000000000000000000000000000000000"
MARKET_ADDRESS="0x0000000000000000000000000000000000000000"
RENTER_POD_FACTORY="0x0000000000000000000000000000000000000000"

# Worker-only custody boundary. Never install this key on the Kamistats host.
KEEPER_PRIVATE_KEY="<required-worker-only-key>"
OPERATOR_RESERVATION_TOKEN="<required-random-32+-character-token>"

OPERATOR_RESERVATION_HOST="127.0.0.1"
# Live v16: 8791 (MUSU), 8792 (VIPP).
OPERATOR_RESERVATION_PORT="8789"
WORKER_STATE_FILE="/var/lib/kami-lease/musu-renter-pod-worker-state.json"
KAMIBOTS_API="https://api.kamibots.xyz"
KAMISTATS_URL="https://kamistats.com"
# 1000..3600000 ms.
POLL_MS="30000"
# Only used when no state file exists yet: the first block to scan for
# RenterPodCreated events (default 0 = start ~2000 blocks behind the tip).
# START_BLOCK=0
# Events are ingested only once this many blocks deep (1..256).
# EVENT_CONFIRMATIONS=12
# Migration only: seed of the pre-v15 provisioning operator, used to recover
# keys of legacy jobs that were stored without one. Leave unset on v16.
# LEGACY_PROVISIONING_OPERATOR_SEED=

# The billed fee per gas (see OPERATOR_TX_PRICING) times this floor, plus 10%
# for the unused-gas charge, must fit in the operator balance before Kamibots
# can start/reconcile. Default is above the measured 1,611,833 gas. The web
# quote and the ops gas sponsor price actions the same way: see
# renter-pod-lease-policy.json (node renter-pod-lease-policy.mjs).
OPERATOR_ACTION_GAS_FLOOR="1700000"
# The billed fee per gas times these gas units is the target operator reserve.
# Twelve million gas covers roughly seven measured actions (about one day).
OPERATOR_RESERVE_GAS_UNITS="12000000"

# Live v16 runs "skip" and the go/no-go keeps it: the operator EOA's leftover
# gas is not returned to the factory at the end (it is small, and a failed
# returnGas must never wedge finalizeGasRefund). "factory" is supported by the
# v16 factory but has not been exercised on the live markets; sealed V15
# accepts returnGas only during PREPARING/ACTIVE and must use "skip".
TERMINAL_GAS_RETURN_MODE="skip"
# Existing v16 factories cannot pullGas after ACTIVE. Keep check-only there:
# the worker proves one action is affordable but does not make a reverting pull.
# Set factory only for a new deployment whose pullGas allows stages 4 and 5.
TERMINAL_GAS_PULL_MODE="check-only"

# --- Launch hardening (all optional; defaults shown) ------------------------
# Worker files to ship with renter-pod-worker.mjs (state and key-store files
# are written with fsync): renter-pod-{active,alerts,
# config,ingest,lease-policy,liveness,quote-store,reservation-server,
# reservations,safety,state,strategy,tick,tx}.mjs plus the existing
# renter-pod-{events,keys,recovery,ending,activation}.mjs and
# kamibots-rental-config.mjs.
# Optional renter allowlist, OFF by default (the public launch runs without
# one; see ALLOW_OPEN_RENTALS). Comma-separated
# addresses, UNQUOTED, the SAME list as the web's LEASE_RENTER_ALLOWLIST.
# Enforced at reservation (403) and keeper attestation (403) when set. Parsing (identical in the web): trim, one pair of
# surrounding quotes stripped, split on ",", empty entries skipped, each entry
# 0x + 40 hex in any case, compared lowercased; any invalid entry (or a value
# with no address at all) is a CONFIG_ERROR at startup, never ignored.
# The quote API verifies a renter signature. Open rentals must be chosen
# explicitly: the ops deploy refuses a .env without a non-empty
# RENTER_ALLOWLIST unless ALLOW_OPEN_RENTALS=true is set, and without either
# the worker prints a loud "RENTER_ALLOWLIST is NOT SET" banner at startup.
# RENTER_ALLOWLIST=0x...,0x...
# Explicit acknowledgement of open rentals (no allowlist). Set it to true for
# the public launch. Read by the ops deploy gate and the startup log; it does
# not change what the worker enforces.
# ALLOW_OPEN_RENTALS=false
# --- Quotes hold no capacity -------------------------------------------------
# A quote (reserve + keeper attest) never reserves anything a throwaway wallet
# could occupy: there is no reservation cap, listing lock, cooldown or attempt
# counter. Two renters racing for one Kami are settled on-chain (the second
# checkout reverts; the web simulates it first and says the Kami was just
# rented). Request volume is bounded by the web's per-IP and per-renter limits.
# Every quote still gets its own random operator key, stored durably before the
# answer (see "Operator key store" below).
# Balance filter: keeper attestation requires the renter's current ETH balance
# (latest block, this worker's RPC) >= the quote's setupGasWei + hubGasWei +
# operatingGasWei; a reserve that sends fundingWei is checked the same way
# before any key is generated. Refusal: 403 {error, code: INSUFFICIENT_BALANCE,
# scope: renter, requiredWei}. An RPC failure refuses with 503
# {code: BALANCE_UNAVAILABLE}; it never admits. Web mirror:
# LEASE_REQUIRE_RENTER_BALANCE.
# REQUIRE_RENTER_BALANCE=true
# Both caps count ON-CHAIN leases only: unreturned ingested pods plus on-chain
# pods parked for ingest retry, distinct per Kami. Quotes never count. At cap,
# reserve and attest answer 429 {code: LEASE_CAP, scope: market}; a Kami that
# already has an on-chain lease never trips it. Concurrent honest checkouts may
# overshoot by the quotes issued just under the cap (each is a real, renter-
# funded lease). The attest quote must carry tokenIndex, and it must be a real
# listing (market.listings(i).owner != 0).
# MAX_ACTIVE_LEASES=20
# On-chain leases ONE renter may hold: 429 {code: RESERVATION_CAP, scope: renter}.
# MAX_ACTIVE_LEASES_PER_RENTER=2
# Every 429 body is {error, code, scope}: LEASE_CAP/market or RESERVATION_CAP/renter.
# How long an UNATTESTED operator key can still be attested, and the furthest
# ahead a quote deadline the keeper signs may be (deadline <= now + this + 60 s;
# a past deadline is refused too). Must be >= 900 (the kamistats quote deadline).
# RESERVATION_TTL_SEC=1200
# RETIRED (ignored; the startup log names any that are still set):
# MAX_LIVE_RESERVATIONS, MAX_RESERVATIONS_PER_RENTER, MAX_RESERVATIONS_PER_LISTING,
# LISTING_SINGLE_CHECKOUT, LISTING_RESERVE_COOLDOWN_SEC,
# MAX_RESERVATION_ATTEMPTS_PER_RENTER.
# Every tx is signed locally and recorded (hash, nonce, raw) in the state file
# BEFORE broadcast; every wait is bounded. A timeout logs [LEASE-ALERT]
# TX_TIMEOUT and the job sends nothing more until that tx is mined, replaced
# (account nonce moved past it) or, unseen with its nonce still free, dropped
# after 2 x this timeout of rebroadcasting the same bytes. A rebroadcast the
# node refuses as "already known" / underpriced proves the tx is still pending
# (a node may hide its mempool), so it is never dropped on that basis. A
# resend after a drop reuses the dropped nonce (kept until the chain's latest
# nonce passes it); if that resend is refused because the nonce is still held,
# the original record is restored. Records not checked for an hour (e.g. across
# a rollback) are never rebroadcast.
# TX_WAIT_TIMEOUT_MS=120000
# Kamibots, tile catalog and JSON-RPC calls.
# FETCH_TIMEOUT_MS=20000
# A tick making NO PROGRESS (no ingest step or job finished) for longer than
# this logs WORKER_STALL and exits(1) for systemd. Job order rotates each tick.
# TICK_WATCHDOG_SEC=600
# Event ingest backlog is read in chunks (blocks per eth_getLogs x calls per
# tick); quotes stay 503 (ingest-stale) until ingest has caught up. A batch
# ingest failure logs "ingest failed (N in a row)" every tick but raises
# [LEASE-ALERT] INGEST_ERROR only from the 2nd consecutive failing tick (the
# live RPC drops a few isolated reads a day).
# LOG_CHUNK_BLOCKS=5000
# LOG_CHUNKS_PER_TICK=20
# eip1559 (default): worker txs keep the ethers EIP-1559 fee fields; gas health
# and the exit reserve are priced at maxFeePerGas, which Yominet bills. legacy:
# worker txs are type 0 at the node gas price (exact cost, about half); switch
# only after an MP-1 smoke receipt confirms effectiveGasPrice.
# OPERATOR_TX_PRICING=eip1559
# Returned superseded (retired) jobs are dropped from the state file after:
# RETIRED_JOB_RETENTION_DAYS=30
# Reservation server answers 503 when the last completed tick (heartbeat.json
# next to the state file) or the last successful event ingest is older.
# HEARTBEAT_STALE_SEC=180
# --- Lease safety (THR-02 / THR-03 / THR-10) --------------------------------
# Exit reserve: operator gas kept for stop-harvest, finalize and KamiSend home,
# priced as N x (OPERATOR_ACTION_GAS_FLOOR + 10%) x billed fee. When operator
# balance + pullable escrow drops below (N + 1) actions during an ACTIVE lease
# the worker stops the Kamibots strategy and the harvest on-chain and logs
# [LEASE-ALERT] EXIT_RESERVE_STOP and ESCROW_LOW. It restarts the strategy only
# after a renter top-up brings the total to (N + 1 + headroom) actions.
# If Kamibots did not confirm the stop (bypassed), escrow is NOT pulled in bulk
# onto the operator EOA the strategy may still control: it is pulled just in
# time, 1 action before endLease / stopHarvest, 2 before the ending txs.
# EXIT_RESERVE_ACTIONS=3
# EXIT_RESUME_HEADROOM_ACTIONS=2
# Refuse mid-lease prefs changes that raise the action rate beyond what the
# remaining escrow covers (ESCROW_LOW reason=cadence-refused). on|off.
# PREFS_CADENCE_GUARD=on
# Strategy safety floor, applied at strategy start and on every prefs update.
# Out-of-floor prefs are clamped and recorded on the job (job.prefsClamped),
# never rejected: HP-based rest on, failsafe rest on, "aggressive" -> "balanced".
# PREFS_FLOOR=off disables the floor entirely (not recommended).
# PREFS_FLOOR=on
# PREFS_FLOOR_HP_LOW_MIN=45
# PREFS_FLOOR_FARM_INTERVAL_MAX_SEC=18000
# PREFS_FLOOR_SAFETY_MARGIN_MIN=5
# PREFS_FLOOR_FEED_PERCENT_MIN=45
# Harvest & Feed always runs on timers at Kamibots. The floor forces HP-based
# feeding (no feed timer) and a rest timer of at least this % of the farm timer
# (measured Kamibots cycle: 147 min rest per 292 min farm). The exact Kamibots
# start body is re-checked against the floor before every start.
# PREFS_FLOOR_REST_PCT_OF_FARM=51
# Harvest & Feed failsafe rest (when food cannot be used - a fresh pod holds
# none) lasts at least max(this, the floored rest timer), 60..72000 s.
# PREFS_FLOOR_FAILSAFE_REST_MIN_SEC=3600
# PREFS_FLOOR_FORCE_HP_FEED=on
# At most one renter-driven Kamibots restart per lease per window; throttled
# restarts log STRATEGY_RESTART_STORM and apply once the window has passed.
# STRATEGY_RESTART_MIN_INTERVAL_SEC=3600
# After this many consecutive Kamibots stop failures the lease ending / return
# continues on-chain without Kamibots (the exit reserve does not wait at all).
# KAMIBOTS_STOP_MAX_FAILURES=3
# Cap of the per-job exponential backoff (30 s doubling) between failing
# Kamibots calls.
# KAMIBOTS_RETRY_MAX_SEC=900
# A DEAD Kami is never revived by the worker: the job is marked (job.dead),
# [LEASE-ALERT] DEAD_KAMI token=.. market=.. stage=.. repeats every
# ALERT_MIN_INTERVAL_SEC, and KamiSend / finalize are skipped until a human
# revives it; the job then resumes on its own. Who pays the revive ONYX is an
# owner policy decision (no runbook exists yet).
# Minimum seconds between repeats of the same [LEASE-ALERT] code+subject.
# ALERT_MIN_INTERVAL_SEC=300
# A job failing continuously this long raises STAGE_STUCK.
# STAGE_STUCK_ALERT_SEC=1800
# --- Operator key store ------------------------------------------------------
# Private keys of quotes in flight (one independent random key per quote; see
# OPERATOR-KEY-CUSTODY.md). Snapshot: RESERVATION_STATE_FILE, default
# <state file minus .json>.reservations.json; append-only journal next to it:
# <same>.reservations.journal. Both 0600. A quote appends + fsyncs one journal
# line before its operator address / keeper signature is returned; the journal
# is folded into the snapshot when it outgrows it, at startup and on SIGTERM.
# Keys are deleted only once provably unusable (unattested past
# RESERVATION_TTL_SEC; attested once ingest has passed the quote deadline in
# chain time; never while the nonce is parked for ingest retry). Nothing
# counts or caps the store. Legacy state files that embed reservations are
# migrated on first start; the state file itself no longer carries keys of
# quotes in flight.
# ROLLBACK PROCEDURE: touch HALT (no new quotes; existing leases keep being
# serviced), then wait until state.pendingTxs is EMPTY (every in-flight tx
# mined or resolved; e.g. jq '.pendingTxs // {} | length' on the state file
# returns 0) - at least one poll interval - then STOP the worker (SIGTERM
# compacts the journal into the snapshot; after a kill run
# `node renter-pod-quote-store.mjs compact <snapshot>` with the worker stopped),
# merge the snapshot into the state file's "reservations" (launch-ops rollback
# does this), move BOTH store files aside, and roll back. The pre-hardening
# worker ignores pendingTxs and txNonceHints: a tx still pending at rollback
# would be re-derived and sent AGAIN under a new nonce. After rolling forward
# again, records that lay dormant are resolved by receipt/nonce but never
# rebroadcast.
# RESERVATION_STATE_FILE=
# While this file exists the reservation server answers 503 (off-chain kill
# switch for new leases; existing leases keep being serviced).
# WORKER_HALT_FILE=<dir of WORKER_STATE_FILE>/HALT
