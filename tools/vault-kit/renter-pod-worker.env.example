YOMINET_RPC="https://rpc.example"
WORLD_ADDR="0x0000000000000000000000000000000000000000"
MARKET_ADDRESS="0x0000000000000000000000000000000000000000"
RENTER_POD_FACTORY="0x0000000000000000000000000000000000000000"

# Worker-only custody boundary. Never install this key on the Kamistats host.
KEEPER_PRIVATE_KEY="<required-worker-only-key>"
OPERATOR_RESERVATION_TOKEN="<required-random-32+-character-token>"

OPERATOR_RESERVATION_HOST="127.0.0.1"
OPERATOR_RESERVATION_PORT="8789"
WORKER_STATE_FILE="/var/lib/kami-lease/musu-renter-pod-worker-state.json"
KAMIBOTS_API="https://api.kamibots.xyz"
KAMISTATS_URL="https://kamistats.com"
POLL_MS="30000"

# Current gas price times this floor must fit in the operator balance before
# Kamibots can start/reconcile. Default is above the measured 1,611,833 gas.
OPERATOR_ACTION_GAS_FLOOR="1700000"
# Current gas price times these gas units is the target operator reserve.
# Twelve million gas covers roughly seven measured actions (about one day).
OPERATOR_RESERVE_GAS_UNITS="12000000"

# V16 accepts terminal returnGas. Sealed V15 accepts it only during
# PREPARING/ACTIVE, so its workers must use "skip" to avoid wedging before
# finalizeGasRefund after the Kami is already home.
TERMINAL_GAS_RETURN_MODE="factory"
# Existing v16 factories cannot pullGas after ACTIVE. Keep check-only there:
# the worker proves one action is affordable but does not make a reverting pull.
# Set factory only for a new deployment whose pullGas allows stages 4 and 5.
TERMINAL_GAS_PULL_MODE="check-only"
