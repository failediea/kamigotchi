# worker-alerts v2. Replaces /etc/systemd/system/kami-worker-alerts.service
# (baseline in ./baseline/). Installed by ../install-launch-ops.sh --component alerts.
[Unit]
Description=Kami lease worker health alert check (v2)
OnFailure=kami-lease-ops-onfailure@%n.service

[Service]
Type=oneshot
Environment=LAUNCH_OPS_ENV=/etc/kami-lease-ops/launch-ops.env
# /bin/bash: the unit runs even if the script lost its exec bit (git archive of a
# 100644 commit); install-launch-ops.sh still enforces the mode.
ExecStart=/bin/bash /root/kamigotchi/tools/launch-ops/alerts/worker-alerts-v2.sh --apply
TimeoutStartSec=300
Nice=5
