# /etc/kami-lease-ops/launch-ops.env  (root:root, mode 600)
# Shared by worker-alerts-v2.sh, lease-expiry-keeper.sh, lease-gas-sponsor.sh.
# install-launch-ops.sh --component alerts creates it from this file and
# migrates NTFY_TOPIC out of the live tools/alerts/worker-alerts.sh without
# printing it. Every value below is the default; uncomment to change.
# Write numbers UNQUOTED: a malformed numeric knob stops the scripts with a message.

# --- notifications (secret-ish: anyone with the topic can read/post) ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- chain ---
# YOMINET_RPC_PUBLIC=https://jsonrpc-yominet-1.anvil.asia-southeast.initia.xyz
# RPC_TIMEOUT_SEC=15
# MUSU_MARKET=0x1FeF5Ce51f9d3BACD0C3f707eEeBbD7A44d69319
# VIPP_MARKET=0x4A34d4847D8E2958E4017353e71fAB7afb85bD23
# KEEPER_ADDR=0x0d0294C57B01ED7189b8A9ba354cf77b935abcDc

# --- node for worker-state reads when jq is missing (alerts, sponsor) ---
# NODE_BIN=/opt/kami-lease/runtime/node-v22.23.4/bin/node
# KAMI_WORKER_ENV_DIR=/etc/kami-lease      # preferred state/RPC config after non-root migration

# --- alerts thresholds ---
# COOLDOWN_SECS=3600
# ERR_THRESHOLD=20
# HEARTBEAT_STALE_SEC=180
# HEARTBEAT_MISSING_MODE=state-mtime      # "alert" once every v16 worker writes heartbeat.json
# TICK_FAIL_RUNS=2
# JOB_ERROR_RUNS=2
# KEEPER_MIN_WEI=400000000000000          # 0.0004 ETH (CHAIN-4)
# FEE_FLOAT_MIN_CLAIMS=20                 # VIPP feeFloatClaimsLeft() (CHAIN-3)
# PREPARING_MAX_SEC=21600                 # 6 h
# EXPIRED_UNENDED_MAX_SEC=3600
# LEASE_HOSTS="lease-musu.kamistats.com lease-vipp.kamistats.com"
# TLS_MIN_DAYS=14
# DISK_MAX_PCT=85
# MEM_MIN_MB=100
# SELF_GAP_SEC=1800
# --- quote key store (operator keys of quotes in flight; OPERATOR-KEY-CUSTODY.md section 7) ---
# QUOTE_STORE_MAX_MB=32                   # snapshot + journal; a 50-IP x 1 h burst peaks at ~12 MB
# QUOTE_STORE_MAX_LIVE=15000              # heartbeat liveReservations; the burst peaks at ~9,200
# QUOTE_STORE_MIN_FREE_MB=256             # free space where the store lives (a failed fsync = quotes 503)
# LEGACY_UNITS="kami-renter-pod-v15-musu kami-renter-pod-v15-vipp kami-lease-bot-v13-musu kami-lease-bot-v13-vipp"
# OPS_UNITS="kami-lease-expiry-keeper.service kami-lease-gas-sponsor.service"

# --- exit reserve: must match the worker .env (EXIT_RESERVE_ACTIONS, EXIT_RESUME_HEADROOM_ACTIONS,
# --- OPERATOR_ACTION_GAS_FLOOR, OPERATOR_TX_PRICING). Priced like the worker: feePerGas =
# --- max(2 x baseFee + priority, gasPrice) (5 Mwei live), action = feePerGas x floor x 1.1.
# --- Do NOT raise OPERATOR_ACTION_GAS_FLOOR to compensate for pricing (old stopgap).
# EXIT_RESERVE_ACTIONS=3
# EXIT_RESUME_HEADROOM_ACTIONS=2
# OPERATOR_ACTION_GAS_FLOOR=1700000
# OPERATOR_TX_PRICING=eip1559             # "legacy" only if the worker .env says legacy

# --- sponsor wallet (expiry keeper + gas sponsor). Key file: one line, 0x-hex key,
# --- root-owned mode 600. The key is never printed; SPONSOR_ADDRESS must match it.
# SPONSOR_KEY_FILE=/root/.kami-lease-sponsor.key
# SPONSOR_ADDRESS=0x...
# TX_WAIT_TIMEOUT_MS=120000
# SIGNER_RPC_TIMEOUT_MS=20000             # per RPC call inside the signer (a lost reply fails fast)

# --- expiry keeper (H7) ---
# EXPIRY_GRACE_SEC=600                    # let the worker's own endLease go first
# EXPIRY_MAX_TX_PER_RUN=5
# SPONSOR_MIN_SEND_WEI=100000000000000

# --- gas sponsor (H7 / H2) ---
# SPONSOR_STAGES="0 3 4 5"                # 3=ACTIVE, 4/5 terminal (pullGas reverts), 0=custody return owed
#                                         # (stage 0 only while the token is listed and not re-leased)
# SPONSOR_TARGET_GAS_UNITS=12000000       # top up to max(this x feePerGas, worker resume level): 6e13 wei at 5 Mwei
# SPONSOR_MAX_PER_LEASE_WEI=100000000000000   # 1e14 cumulative per lease
# SPONSOR_MAX_PER_DAY_WEI=300000000000000     # 3e14 rolling 24 h
# SPONSOR_WALLET_FLOOR_WEI=200000000000000    # never drain the sponsor below 2e14
# SPONSOR_MAX_TX_PER_RUN=3
